# Backend Environment Variables
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:3000

# Clerk Authentication
# Find in Clerk Dashboard -> API Keys
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Find in Clerk Dashboard -> Paths / Domain (e.g. https://your-app.clerk.accounts.dev or custom domain)
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000","https://your-frontend-cloudrun-url.a.run.app"]

# GCP & Vertex AI Configuration
# Gemini model configurable via env
GEMINI_MODEL_ID=gemini-2.0-flash
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
